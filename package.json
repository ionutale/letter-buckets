{
	"name": "letter-buckets",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"packageManager": "pnpm@12.6.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "node scripts/serve-preview.mjs",
		"preview:vite": "vite preview",
		"prepare": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations && svelte-kit sync",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:e2e": "playwright test tests/e2e",
		"test:visual": "playwright test tests/visual --project=chromium",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"icons": "node scripts/generate-icons.mjs",
		"content:export": "tsx scripts/export_content.ts",
		"assets:audio": "node scripts/generate_audio.mjs",
		"assets:art": "python3 scripts/generate_art.py",
		"validate:assets": "node scripts/validate_assets.mjs",
		"size": "node scripts/check_build_size.mjs",
		"assets:words": "python3 scripts/generate_word_art.py --all",
		"deploy:cf": "pnpm build && pnpm dlx wrangler@latest pages deploy build --project-name letter-buckets"
	},
	"dependencies": {
		"@fontsource/nunito": "^5.2.5"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@playwright/test": "^1.64.1",
		"@resvg/resvg-js": "^2.6.2",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@testing-library/svelte": "^5.2.8",
		"@types/node": "^26.6.4",
		"jsdom": "^26.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
